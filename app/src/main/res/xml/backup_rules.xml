<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Cookie profiles are stored in this Room database. -->
    <exclude domain="database" path="app_database" />
    <exclude domain="database" path="app_database-shm" />
    <exclude domain="database" path="app_database-wal" />
    <!-- The built-in WebView keeps site logins (cookies, storage) under app_webview. -->
    <exclude domain="root" path="app_webview" />
    <!-- APK blobs, temporary files and retention accounting must not restore on another installation. -->
    <exclude domain="file" path="update-apks/" />
</full-backup-content>
